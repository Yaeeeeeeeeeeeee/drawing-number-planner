{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": false
  },
  "include": ["src/main/**/*.ts", "src/main/**/*.cts", "src/server/**/*.ts", "src/service/**/*.ts"]
}
