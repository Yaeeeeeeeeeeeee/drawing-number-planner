{
  "name": "drawing-number-planner",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "图号规划、BOM及包材文件管理系统",
  "main": "dist/main/index.js",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.main.json",
    "dev:web": "concurrently -k \"tsx watch src/server/dev.ts\" \"vite --host 127.0.0.1\"",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch\" \"wait-on http://127.0.0.1:5173 dist/main/index.js dist/service/entry.js && electron . --dev-server-url=http://127.0.0.1:5173\""
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "archiver": "8.0.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "lucide-react": "1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "^9.3.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0",
    "write-excel-file": "^4.1.1"
  }
}
